{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the locally-served dashboard and widget pages. Scoped to the local sidecar origin only, so a page loaded from a remote backend gets none of these.",
  "windows": ["main", "widget"],
  "remote": {
    "urls": ["http://127.0.0.1:8877/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-show-native-toast",
    "allow-snooze-alert",
    "allow-acknowledge-alert",
    "allow-show-main",
    "allow-hide-widget",
    "allow-get-desktop-settings",
    "allow-set-desktop-settings",
    "allow-list-monitors",
    "allow-list-audio-devices",
    "allow-armed-state",
    "allow-capture-controller-button"
  ]
}
